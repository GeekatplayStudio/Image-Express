{
  "name": "creative-flow",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=11 <12"
  },
  "main": "electron/main.js",
  "overrides": {
    "tar": "^7.5.6"
  },
  "scripts": {
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "node scripts/start-web.mjs dev",
    "launch": "node scripts/launch.mjs",
    "prebuild": "node scripts/ensure-deps.mjs",
    "build": "next build",
    "prestart": "node scripts/ensure-deps.mjs",
    "start": "node scripts/start-web.mjs prod",
    "audit:repo": "node scripts/repo-audit.mjs",
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "audit:i18n:parity": "node scripts/i18n-audit.mjs --parity",
    "install:super": "node scripts/super-installer.mjs",
    "qa:install": "node scripts/qa-installation.mjs",
    "qa:ollama": "node scripts/qa-ollama.mjs",
    "qa:overlay": "playwright test e2e/export-verification.spec.ts e2e/media-overlay-verification.spec.ts",
    "lint": "eslint",
    "validate": "npm run lint && npm run test && npm run build",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "desktop:dev": "concurrently \"cross-env NEXT_DESKTOP=1 NEXT_DESKTOP_PORT=3927 next dev -p 3927\" \"wait-on http://localhost:3927 && cross-env NEXT_DESKTOP=1 NEXT_DESKTOP_PORT=3927 electron .\"",
    "desktop:serve": "concurrently \"cross-env NEXT_DESKTOP=1 NEXT_DESKTOP_PORT=3927 next start -p 3927\" \"wait-on http://localhost:3927 && cross-env NEXT_DESKTOP=1 NEXT_DESKTOP_PORT=3927 electron .\"",
    "desktop:start": "npm run build && npm run desktop:serve",
    "desktop:build": "next build && electron-builder",
    "update": "node scripts/update.mjs",
    "update:check": "node scripts/update.mjs --check",
    "desktop:dist:win": "next build && electron-builder --win",
    "desktop:dist:mac": "next build && electron-builder --mac",
    "desktop:pack": "next build && electron-builder --dir",
    "mcp": "node scripts/mcp-server.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/pacifico": "^5.2.7",
    "@fontsource/playfair-display": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@types/jspdf": "^1.3.3",
    "@types/three": "^0.182.0",
    "ag-psd": "^31.0.2",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "fabric": "^7.1.0",
    "heic-to": "^1.5.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "mime": "^4.1.0",
    "next": "^16.2.10",
    "opentype.js": "^1.3.4",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "utif2": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.12",
    "@types/jszip": "^3.4.1",
    "@types/mime": "^3.0.4",
    "@types/node": "^24.10.0",
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^40.0.0",
    "electron-builder": "^26.5.0",
    "electron-updater": "^6.3.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.imageexpress.desktop",
    "productName": "Image Express",
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next-standalone"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "next-standalone/node_modules"
      },
      {
        "from": ".next/standalone/.next",
        "to": "next-standalone/.next"
      },
      {
        "from": ".next/static",
        "to": "next-standalone/.next/static"
      },
      {
        "from": "public",
        "to": "next-standalone/public",
        "filter": [
          "**/*",
          "!assets/**"
        ]
      },
      {
        "from": "node_modules/next/dist/compiled/next-server",
        "to": "next-standalone/node_modules/next/dist/compiled/next-server"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "ImageExpress-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ImageExpress-Setup-${version}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "asar": true,
    "npmRebuild": false
  },
  "description": "Image Express — AI design studio",
  "author": "Geekatplay <geekatplay@gmail.com>"
}
