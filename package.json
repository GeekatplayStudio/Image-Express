{
  "name": "creative-flow",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=11 <12"
  },
  "main": "electron/main.js",
  "overrides": {
    "tar": "^7.5.21",
    "fast-uri": "^3.1.4",
    "sharp": "^0.35.0",
    "postcss": "^8.5.10",
    "brace-expansion@1": "^1.1.17",
    "brace-expansion@2": "^2.1.3",
    "brace-expansion@5": "^5.0.8",
    "builder-util-runtime": "^9.7.0",
    "@hono/node-server": "^2.0.12",
    "js-yaml": "^4.3.0",
    "http-cache-semantics": "^4.2.0"
  },
  "scripts": {
    "doctor:node": "node scripts/node-guard.mjs",
    "setup": "node scripts/ensure-deps.mjs --force",
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "node scripts/start-web.mjs dev",
    "launch": "node scripts/launch.mjs",
    "prebuild": "node scripts/ensure-deps.mjs && node scripts/prepare-build.mjs",
    "build": "node scripts/build.mjs",
    "prestart": "node scripts/ensure-deps.mjs",
    "start": "node scripts/start-web.mjs prod",
    "audit:repo": "node scripts/repo-audit.mjs",
    "audit:architecture": "node scripts/architecture-check.mjs",
    "audit:bundle": "node scripts/bundle-budget.mjs",
    "audit:dependencies": "node scripts/security-overrides-check.mjs && node scripts/dependency-audit.mjs",
    "audit:overrides": "node scripts/security-overrides-check.mjs",
    "audit:i18n": "node scripts/i18n-audit.mjs --parity && node scripts/i18n-scan.mjs",
    "audit:i18n:strings": "node scripts/i18n-scan.mjs",
    "audit:terms": "node scripts/terminology-audit.mjs",
    "audit:i18n:parity": "node scripts/i18n-audit.mjs --parity",
    "i18n:export": "node scripts/i18n-export-missing.mjs",
    "i18n:import": "node scripts/i18n-import-translated.mjs",
    "install:super": "node scripts/super-installer.mjs",
    "qa:install": "node scripts/qa-installation.mjs",
    "qa:ollama": "node scripts/qa-ollama.mjs",
    "qa:overlay": "playwright test e2e/export-verification.spec.ts e2e/media-overlay-verification.spec.ts",
    "test:e2e:critical": "playwright test e2e/export-verification.spec.ts e2e/media-overlay-verification.spec.ts",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "verify": "npm run audit:overrides && npm run audit:architecture && npm run lint && npm run typecheck && npm test -- --runInBand && npm run build && npm run audit:bundle",
    "validate": "npm run lint && npm run test && npm run build",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "electron:ensure": "node scripts/ensure-electron.mjs",
    "predesktop:dev": "node scripts/ensure-electron.mjs",
    "predesktop:serve": "node scripts/ensure-electron.mjs",
    "predesktop:build": "node scripts/ensure-electron.mjs",
    "predesktop:pack": "node scripts/ensure-electron.mjs",
    "predesktop:dist:win": "node scripts/ensure-electron.mjs",
    "predesktop:dist:mac": "node scripts/ensure-electron.mjs",
    "predesktop:dist:linux": "node scripts/ensure-electron.mjs",
    "desktop:dev": "concurrently \"cross-env NEXT_DESKTOP=1 NEXT_DESKTOP_PORT=3927 next dev -p 3927\" \"wait-on http://localhost:3927 && cross-env NEXT_DESKTOP=1 NEXT_DESKTOP_PORT=3927 electron .\"",
    "desktop:serve": "concurrently \"cross-env NEXT_DESKTOP=1 NEXT_DESKTOP_PORT=3927 next start -p 3927\" \"wait-on http://localhost:3927 && cross-env NEXT_DESKTOP=1 NEXT_DESKTOP_PORT=3927 electron .\"",
    "desktop:start": "npm run build && npm run desktop:serve",
    "desktop:build": "npm run build && electron-builder",
    "update": "node scripts/update.mjs",
    "update:check": "node scripts/update.mjs --check",
    "desktop:dist:win": "npm run build && electron-builder --win",
    "desktop:dist:mac": "npm run build && electron-builder --mac",
    "desktop:dist:linux": "npm run build && electron-builder --linux",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:verify-package": "node scripts/verify-package.mjs",
    "desktop:smoke-package": "node scripts/smoke-package.mjs",
    "mcp": "node scripts/mcp-server.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/pacifico": "^5.2.7",
    "@fontsource/playfair-display": "^5.2.8",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@types/three": "^0.182.0",
    "ag-psd": "^31.0.2",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "fabric": "^7.1.0",
    "heic-to": "^1.5.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "mime": "^4.1.0",
    "next": "^16.2.11",
    "opentype.js": "^1.3.4",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "utif2": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^40.0.0",
    "electron-builder": "^26.5.0",
    "electron-updater": "^6.3.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.imageexpress.desktop",
    "productName": "Image Express",
    "directories": {
      "buildResources": "electron/assets",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GeekatplayStudio",
        "repo": "Image-Express"
      }
    ],
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/debug/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/universalify/**/*",
      "!node_modules/.cache/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next-standalone"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "next-standalone/node_modules"
      },
      {
        "from": ".next/standalone/.next",
        "to": "next-standalone/.next"
      },
      {
        "from": ".next/static",
        "to": "next-standalone/.next/static"
      },
      {
        "from": "public",
        "to": "next-standalone/public",
        "filter": [
          "**/*",
          "!assets/**"
        ]
      },
      {
        "from": "node_modules/next/dist/compiled/next-server",
        "to": "next-standalone/node_modules/next/dist/compiled/next-server"
      },
      {
        "from": "node_modules",
        "to": "electron-runtime/node_modules",
        "filter": [
          "electron-updater/**/*",
          "builder-util-runtime/**/*",
          "debug/**/*",
          "fs-extra/**/*",
          "graceful-fs/**/*",
          "js-yaml/**/*",
          "argparse/**/*",
          "jsonfile/**/*",
          "lazy-val/**/*",
          "lodash.escaperegexp/**/*",
          "lodash.isequal/**/*",
          "ms/**/*",
          "sax/**/*",
          "semver/**/*",
          "tiny-typed-emitter/**/*",
          "universalify/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "icon.png",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "ImageExpress-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "icon.png",
      "category": "Graphics",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ImageExpress-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ImageExpress-Setup-${version}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "asar": true,
    "npmRebuild": false
  },
  "description": "Image Express — AI design studio",
  "author": "Geekatplay <geekatplay@gmail.com>"
}
